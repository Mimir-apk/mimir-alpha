    Files: nes, snes, gb, gbc, gba, nds, nds_dec, 3ds, 3ds_dec, n64, genesis, mastersystem,
    gamegear, sg1000, atari2600, atari7800, atarilynx, pcengine, ngp, ngpc, virtualboy,
