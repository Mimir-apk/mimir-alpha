<?xml version="1.0" encoding="utf-8"?>
<!-- Mimir adaptive-icon foreground: the gold ᛗ Mannaz rune (Mimir's M-rune brand mark, identical geometry
     to #mimirMark in thor-torrent-shop/index.html: two staves bound by a crossed middle, satin-gold, butt caps).
     The source mark lives in viewBox "10 13 44 44"; the staves run x=20..44, y=20..50. Here it's scaled x1.5 and
     centered at (54,54) of the 108x108 adaptive viewport so the glyph sits inside the ~66dp mask safe zone
     (no launcher shape clips the staves). Gold gradient mirrors #mimirGold (#ffda64 -> #d4af69 -> #8b6f47). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:translateX="6"
        android:translateY="1.5">
        <!-- two vertical staves -->
        <path
            android:strokeWidth="4"
            android:strokeLineCap="butt"
            android:pathData="M20,20 V50 M44,20 V50">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="20" android:startY="20"
                    android:endX="44" android:endY="50"
                    android:startColor="#FFDA64"
                    android:centerColor="#D4AF69"
                    android:endColor="#8B6F47" />
            </aapt:attr>
        </path>
        <!-- crossed middle -->
        <path
            android:strokeWidth="3.2"
            android:strokeLineCap="butt"
            android:pathData="M20,20 L44,36 M44,20 L20,36">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="20" android:startY="20"
                    android:endX="44" android:endY="36"
                    android:startColor="#FFDA64"
                    android:centerColor="#D4AF69"
                    android:endColor="#8B6F47" />
            </aapt:attr>
        </path>
    </group>
</vector>
