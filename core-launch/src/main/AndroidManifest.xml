<?xml version="1.0" encoding="utf-8"?>
<!-- Mimir Alpha :core-launch — library manifest. Posture: NO INTERNET; NO QUERY_ALL_PACKAGES.
     Emulator-installed checks use scoped <queries> declared by the app, not broad visibility. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required by IntentLaunchDispatcher's best-effort cleanup of the prior emulator process. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
</manifest>
