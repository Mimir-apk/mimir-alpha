    },
    "idMapVersion": {
      "const": "mimirPlatformIdMap.v1"
    },
    "registryRevision": {
      "$ref": "#/$defs/registryRevision"
    },
    "schemaVersion": {
      "const": "mimirPlatformRegistry.v2"
    },
    "sourceProvenance": {
      "$ref": "#/$defs/sourceProvenance"
    }
  },
  "required": [
