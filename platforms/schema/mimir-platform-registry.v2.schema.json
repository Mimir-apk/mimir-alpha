    "collections",
    "compatibilityFloor",
    "counts",
    "digests",
    "generatedBy",
    "idMapVersion",
    "registryRevision",
    "schemaVersion",
    "sourceProvenance"
  ],
  "title": "Mimir canonical platform registry v2",
  "type": "object",
