          "type": "array",
          "uniqueItems": true
        },
        "conditionalContent": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "hiddenContentKinds": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "schemaVersion": {
          "const": "mimirPlatformContentRules.v1"
        },
        "sidecarRules": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "supportExtensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "supportFolders": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "supportReasons": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "truth": {
          "minLength": 1,
          "type": "string"
        }
