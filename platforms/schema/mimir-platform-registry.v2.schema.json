      "required": [
        "canonicalResolution",
        "expectedRuntimeIds",
        "extraCatalogDefaultIds",
        "id",
        "missingCatalogDefaultIds",
        "observedCatalogDefaultIds",
        "status"
      ],
      "type": "object"
    },
    "platform": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": { "$ref": "#/$defs/alias" },
          "type": "array",
          "uniqueItems": true
        },
        "contentProfileIds": {
          "items": { "$ref": "#/$defs/scopedId" },
          "type": "array",
          "uniqueItems": true
        },
        "definitionStatus": { "const": "PROVISIONAL_SOURCE_ONLY" },
        "display": { "$ref": "#/$defs/display" },
        "folder": { "$ref": "#/$defs/folderContract" },
        "id": { "$ref": "#/$defs/platformId" },
        "identity": {
          "items": { "type": "object" },
          "type": "array"
        },
        "launchRouteIds": {
          "items": { "$ref": "#/$defs/scopedId" },
          "type": "array",
          "uniqueItems": true
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      },
      "required": [
        "aliases",
        "contentProfileIds",
        "definitionStatus",
        "display",
        "folder",
        "id",
        "identity",
        "launchRouteIds",
        "presentation"
      ],
      "type": "object"
    },
    "platformId": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "type": "string"
    },
    "presentation": {
      "additionalProperties": false,
      "properties": {
        "catalogEntryIds": {
          "items": { "$ref": "#/$defs/scopedId" },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "visualAssetKeys": {
          "items": { "$ref": "#/$defs/scopedId" },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "catalogEntryIds",
        "visualAssetKeys"
      ],
      "type": "object"
    },
    "recognitionState": {
      "additionalProperties": false,
      "properties": {
        "folder": { "minLength": 1, "type": "string" },
        "id": { "$ref": "#/$defs/scopedId" },
        "value": { "const": "unknown" }
      },
      "required": [
        "folder",
        "id",
        "value"
      ],
      "type": "object"
    },
    "registryRevision": {
      "pattern": "^pk00-[0-9a-f]{12}-[0-9a-f]{12}$",
      "type": "string"
    },
    "relation": {
      "enum": [
        "CANONICAL",
        "CONTENT_VARIANT",
        "HARDWARE_VARIANT",
        "PRESENTATION_ALIAS",
        "REGIONAL_VARIANT",
        "SOFTWARE_FAMILY"
      ],
      "type": "string"
    },
    "relationEvidence": {
      "additionalProperties": false,
      "properties": {
        "canonicalSourceIconFile": { "minLength": 1, "type": "string" },
        "classificationFixture": { "minLength": 1, "type": "string" },
        "classificationFixtureSha256": { "$ref": "#/$defs/sha256" },
        "sourceIconFile": { "minLength": 1, "type": "string" }
      },
      "required": [
        "canonicalSourceIconFile",
        "classificationFixture",
        "classificationFixtureSha256",
        "sourceIconFile"
      ],
      "type": "object"
    },
    "retroArchCoreRegistration": {
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/scopedId" },
        "isRecommended": { "type": "boolean" },
        "label": { "minLength": 1, "type": "string" },
        "sourceOrdinal": { "minimum": 0, "type": "integer" },
        "stem": { "minLength": 1, "type": "string" }
      },
      "required": [
        "id",
        "isRecommended",
        "label",
        "sourceOrdinal",
        "stem"
      ],
      "type": "object"
    },
    "retroArchRegistration": {
      "additionalProperties": false,
      "properties": {
        "contentProfileId": { "$ref": "#/$defs/scopedId" },
        "coreRegistrations": {
          "items": { "$ref": "#/$defs/retroArchCoreRegistration" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "externalId": { "$ref": "#/$defs/externalId" },
        "id": { "$ref": "#/$defs/scopedId" },
        "label": { "minLength": 1, "type": "string" },
        "platformId": { "$ref": "#/$defs/platformId" },
        "recommendedCore": { "minLength": 1, "type": "string" }
      },
      "required": [
        "contentProfileId",
        "coreRegistrations",
        "externalId",
        "id",
        "label",
        "platformId",
        "recommendedCore"
      ],
      "type": "object"
    },
    "scopedId": {
      "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9._:+-]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "shippingRuntimeSystem": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "items": { "type": "string" },
          "type": "array",
          "uniqueItems": true
        },
        "externalId": { "$ref": "#/$defs/externalId" },
        "folder": { "minLength": 1, "type": "string" },
        "folderAliases": {
          "items": { "type": "string" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": { "$ref": "#/$defs/scopedId" },
        "label": { "minLength": 1, "type": "string" },
        "platformId": { "$ref": "#/$defs/platformId" },
        "sourceOrdinal": { "minimum": 0, "type": "integer" }
      },
      "required": [
        "extensions",
        "externalId",
        "folder",
