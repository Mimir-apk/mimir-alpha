      "type": "object"
    },
    "catalogEntry": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "$ref": "#/$defs/display"
        },
        "externalId": {
          "$ref": "#/$defs/externalId"
        },
        "folderContract": {
          "$ref": "#/$defs/folderContract"
        },
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "importBindingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "launchConfidenceObservation": {
          "enum": [
            "core-generic",
            "experimental-open-only",
            "untested",
            "verified"
          ],
          "type": "string"
        },
        "legacyRetroArchLabelObservations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platformId": {
          "$ref": "#/$defs/platformId"
        },
        "relation": {
          "$ref": "#/$defs/relation"
        },
        "relationEvidence": {
          "$ref": "#/$defs/relationEvidence"
        },
        "retroArchRegistrationIds": {
          "items": {
            "$ref": "#/$defs/scopedId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "searchTokens": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sourceOrdinal": {
          "minimum": 0,
          "type": "integer"
        },
        "standaloneTargetObservationIds": {
          "items": {
            "$ref": "#/$defs/scopedId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "visualAssetId": {
          "$ref": "#/$defs/scopedId"
        }
      },
      "required": [
        "display",
        "externalId",
        "folderContract",
        "id",
        "importBindingId",
        "launchConfidenceObservation",
        "legacyRetroArchLabelObservations",
        "platformId",
        "relation",
        "relationEvidence",
        "retroArchRegistrationIds",
        "searchTokens",
        "sourceOrdinal",
        "standaloneTargetObservationIds",
        "visualAssetId"
      ],
      "type": "object"
    },
    "catalogRelationFixture": {
      "additionalProperties": false,
      "properties": {
        "canonicalSourceIconFile": {
          "minLength": 1,
          "type": "string"
        },
        "catalogEntryId": {
          "$ref": "#/$defs/scopedId"
        },
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "platformId": {
          "$ref": "#/$defs/platformId"
        },
        "relation": {
          "enum": [
            "CONTENT_VARIANT",
            "HARDWARE_VARIANT",
            "PRESENTATION_ALIAS",
            "REGIONAL_VARIANT",
            "SOFTWARE_FAMILY"
          ],
          "type": "string"
        },
        "sourceIconFile": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "canonicalSourceIconFile",
        "catalogEntryId",
        "id",
        "platformId",
        "relation",
        "sourceIconFile"
      ],
      "type": "object"
    },
    "collections": {
      "additionalProperties": false,
      "properties": {
        "catalogEntries": {
          "items": {
            "$ref": "#/$defs/catalogEntry"
          },
          "type": "array",
          "uniqueItems": true
        },
        "catalogRelationFixtures": {
          "items": {
            "$ref": "#/$defs/catalogRelationFixture"
          },
          "type": "array",
          "uniqueItems": true
        },
        "contentProfiles": {
          "items": {
            "$ref": "#/$defs/contentProfile"
          },
          "type": "array",
          "uniqueItems": true
        },
        "emulatorFamilies": {
          "items": {
            "$ref": "#/$defs/emulatorFamily"
          },
          "type": "array",
          "uniqueItems": true
        },
        "firmwarePolicies": {
          "items": {
            "$ref": "#/$defs/firmwarePolicy"
          },
          "type": "array",
          "uniqueItems": true
        },
        "importBindings": {
          "items": {
            "$ref": "#/$defs/importBinding"
          },
          "type": "array",
          "uniqueItems": true
        },
        "launchRoutes": {
          "items": {
            "$ref": "#/$defs/launchRoute"
          },
          "type": "array",
          "uniqueItems": true
        },
        "parityFixtures": {
          "items": {
            "$ref": "#/$defs/parityFixture"
          },
          "type": "array",
          "uniqueItems": true
        },
        "platforms": {
          "items": {
            "$ref": "#/$defs/platform"
          },
          "type": "array",
          "uniqueItems": true
        },
        "recognitionStates": {
          "items": {
            "$ref": "#/$defs/recognitionState"
          },
          "type": "array",
          "uniqueItems": true
        },
        "retroArchRegistrations": {
          "items": {
            "$ref": "#/$defs/retroArchRegistration"
          },
          "type": "array",
          "uniqueItems": true
        },
        "shippingRuntimeSystems": {
          "items": {
            "$ref": "#/$defs/shippingRuntimeSystem"
          },
          "type": "array",
          "uniqueItems": true
        },
        "standaloneTargetObservations": {
          "items": {
            "$ref": "#/$defs/standaloneTargetObservation"
          },
          "type": "array",
          "uniqueItems": true
        },
        "supportSlices": {
          "items": {
            "$ref": "#/$defs/supportSlice"
          },
          "type": "array",
          "uniqueItems": true
        },
        "visualAssets": {
          "items": {
            "$ref": "#/$defs/visualAsset"
          },
          "type": "array",
          "uniqueItems": true
        }
