      "required": [
        "baseGameExtensions",
        "conditionalContent",
        "hiddenContentKinds",
        "schemaVersion",
        "sidecarRules",
        "supportExtensions",
        "supportFolders",
        "supportReasons",
        "truth"
      ],
      "type": "object"
    },
    "contentProfile": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "contentContract": {
              "$ref": "#/$defs/contentContract"
            },
            "discoveryStatus": {
              "const": "BOUND"
            }
          },
          "required": [
            "contentContract",
            "discoveryStatus"
          ]
        },
        {
          "properties": {
            "contentContract": {
              "type": "null"
            },
            "discoveryStatus": {
              "const": "GAP"
            }
          },
          "required": [
            "contentContract",
            "discoveryStatus"
          ]
        }
      ],
      "properties": {
        "contentContract": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentContract"
            },
            {
              "type": "null"
            }
          ]
        },
        "discoveryStatus": {
          "enum": [
            "BOUND",
            "GAP"
          ],
          "type": "string"
        },
        "externalId": {
          "$ref": "#/$defs/externalId"
        },
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "platformId": {
          "$ref": "#/$defs/platformId"
        }
      },
      "required": [
        "contentContract",
        "discoveryStatus",
        "externalId",
        "id",
        "platformId"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "catalogEntries": { "const": 403 },
        "catalogRelationFixtures": { "const": 178 },
        "contentProfiles": { "const": 117 },
        "emulatorFamilies": { "const": 0 },
        "firmwarePolicies": { "const": 0 },
        "importBindings": { "const": 107 },
        "launchRoutes": { "const": 0 },
        "parityFixtures": { "const": 1 },
        "platforms": { "const": 226 },
        "recognitionStates": { "const": 1 },
        "retroArchCoreRegistrations": { "const": 116 },
        "retroArchRegistrations": { "const": 49 },
        "shippingRuntimeSystems": { "const": 21 },
        "standaloneTargetObservations": { "const": 44 },
        "supportSlices": { "const": 0 },
        "visualAssets": { "const": 403 }
      },
      "required": [
        "catalogEntries",
        "catalogRelationFixtures",
        "contentProfiles",
        "emulatorFamilies",
        "firmwarePolicies",
        "importBindings",
        "launchRoutes",
        "parityFixtures",
        "platforms",
        "recognitionStates",
        "retroArchCoreRegistrations",
        "retroArchRegistrations",
        "shippingRuntimeSystems",
        "standaloneTargetObservations",
        "supportSlices",
        "visualAssets"
      ],
      "type": "object"
    },
    "digests": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "mimir-canonical-json-v1"
        },
        "collections": {
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          },
          "type": "object"
        },
        "registryPayloadSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "collections",
        "registryPayloadSha256"
      ],
      "type": "object"
    },
    "display": {
      "additionalProperties": false,
      "properties": {
        "displayName": { "minLength": 1, "type": "string" },
        "manufacturer": { "minLength": 1, "type": "string" },
        "shortName": { "minLength": 1, "type": "string" },
        "type": { "minLength": 1, "type": "string" }
      },
      "required": [
        "displayName",
        "manufacturer",
        "shortName",
        "type"
      ],
      "type": "object"
    },
    "emulatorFamily": {
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/scopedId" }
      },
      "required": ["id"],
      "type": "object"
    },
    "externalId": {
      "additionalProperties": false,
      "properties": {
        "namespace": { "minLength": 1, "type": "string" },
        "value": { "minLength": 1, "type": "string" }
      },
      "required": [
        "namespace",
        "value"
      ],
      "type": "object"
    },
    "firmwarePolicy": {
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/scopedId" },
        "platformId": { "$ref": "#/$defs/platformId" }
      },
      "required": [
        "id",
        "platformId"
      ],
      "type": "object"
    },
    "folderContract": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": { "type": "string" },
          "type": "array",
          "uniqueItems": true
        },
        "canonicalFolder": { "minLength": 1, "type": "string" },
        "caseSensitive": { "type": "boolean" },
        "flatDumpPolicy": { "minLength": 1, "type": "string" },
        "platformId": { "minLength": 1, "type": "string" },
        "schemaVersion": { "const": "mimirPlatformFolderContract.v1" },
        "truth": { "minLength": 1, "type": "string" }
      },
      "required": [
        "aliases",
        "canonicalFolder",
        "caseSensitive",
        "flatDumpPolicy",
        "platformId",
        "schemaVersion",
        "truth"
      ],
      "type": "object"
    },
    "importBinding": {
      "additionalProperties": false,
      "properties": {
        "catalogEntryId": {
          "oneOf": [
            { "$ref": "#/$defs/scopedId" },
            { "type": "null" }
          ]
        },
        "contentProfileId": { "$ref": "#/$defs/scopedId" },
        "id": { "$ref": "#/$defs/scopedId" },
        "platformId": { "$ref": "#/$defs/platformId" },
        "sourceExternalId": { "$ref": "#/$defs/externalId" }
      },
      "required": [
        "catalogEntryId",
        "contentProfileId",
        "id",
        "platformId",
        "sourceExternalId"
      ],
      "type": "object"
    },
    "interpretationInput": {
      "additionalProperties": false,
      "properties": {
        "id": { "minLength": 1, "type": "string" },
        "path": { "minLength": 1, "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "launchRoute": {
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/scopedId" },
        "kind": {
          "enum": [
            "EMULATOR_HANDOFF",
            "RETROARCH",
            "STANDALONE"
          ],
          "type": "string"
        },
        "packageVariantIds": {
          "items": { "$ref": "#/$defs/scopedId" },
          "type": "array",
          "uniqueItems": true
        },
        "platformId": { "$ref": "#/$defs/platformId" },
        "precedence": { "type": "integer" }
      },
      "required": [
        "id",
        "kind",
        "packageVariantIds",
        "platformId",
        "precedence"
      ],
      "type": "object"
    },
    "parityFixture": {
      "additionalProperties": false,
      "properties": {
        "canonicalResolution": {
          "additionalProperties": false,
          "properties": {
            "alias": { "$ref": "#/$defs/externalId" },
            "targetPlatformId": { "const": "nintendo_wii" }
          },
          "required": [
            "alias",
            "targetPlatformId"
          ],
          "type": "object"
        },
        "expectedRuntimeIds": {
          "items": { "$ref": "#/$defs/platformId" },
          "type": "array",
          "uniqueItems": true
        },
        "extraCatalogDefaultIds": {
          "items": { "$ref": "#/$defs/platformId" },
          "type": "array",
          "uniqueItems": true
        },
        "id": { "const": "shipping-catalog-default-active-wii-drift" },
        "missingCatalogDefaultIds": {
          "items": { "$ref": "#/$defs/platformId" },
          "type": "array",
          "uniqueItems": true
        },
        "observedCatalogDefaultIds": {
          "items": { "$ref": "#/$defs/platformId" },
          "type": "array",
          "uniqueItems": true
        },
        "status": { "const": "RESOLVED_BY_SCOPED_ALIAS" }
