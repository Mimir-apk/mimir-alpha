        "catalogEntries",
        "catalogRelationFixtures",
        "contentProfiles",
        "emulatorFamilies",
        "firmwarePolicies",
        "importBindings",
        "launchRoutes",
        "parityFixtures",
        "platforms",
        "recognitionStates",
        "retroArchRegistrations",
        "shippingRuntimeSystems",
        "standaloneTargetObservations",
        "supportSlices",
        "visualAssets"
